# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build absolute outfit URLs (for "Copy Outfit Link" and SEO metadata).
# Set this to your deployed domain, e.g. https://outfitandco.com
# For local development this can stay as http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
